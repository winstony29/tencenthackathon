# Copy to .env and fill in. Never commit .env.

# TypeSafe Jev (app/intent/jev.py)
TYPESAFE_API_KEY=

# EdgeOne Makers native System One presentation demo (web/jev.py)
MAKERS_MODELS_KEY=

# HMAC key for stand-in numbers sent to Jev; random per process if empty (D-026)
MASK_KEY=

# LLM for the prompt rewriter and the validation agent (app/llm.py), see D-009
LLM_BASE_URL=
LLM_API_KEY=
REWRITER_MODEL=
VALIDATOR_MODEL=

# Tencent Cloud ASR (app/intent/asr.py)
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-singapore

# Server secret for validation receipts (app/validation/validator.py), see D-011
VALIDATION_RECEIPT_KEY=

# 1 = tests and local runs use fake Jev / LLM / ASR instead of real calls
USE_FAKES=0

# Independent validator: signed-in Local Codex for development, or compatible-api
VALIDATOR_PROVIDER=codex
VALIDATOR_CODEX_MODEL=

# Generate independently; required for persistent auditing. Never expose in frontend.
AUDIT_EVIDENCE_KEY=
AUDIT_ADMIN_TOKEN=
AUDIT_RETENTION_DAYS=7

# Opt-in supervised LOCAL bank execution (initialize before enabling in the server).
BANK_EXECUTION_ENABLED=0
BANK_SUPERVISED_USER=u_demo
# Blank transfer policy uses the committed user's transfer_policy from data/bank.json.
BANK_TRANSFER_POLICY=
BANK_GATEWAY_POLICY={"nonce_lifetime_seconds":120,"receipt_lifetime_seconds":300,"max_receipt_bytes":4096,"max_draft_bytes":32768,"max_store_bytes":8388608,"max_challenges":1000,"max_challenges_per_user":20,"max_events":5000,"max_attempts":5}
# Blank uses var/approvals.sqlite3; keep this separate from AUDIT_EVIDENCE_PATH.
TRANSACTION_STATE_PATH=
